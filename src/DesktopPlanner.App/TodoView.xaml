<UserControl x:Class="DesktopPlanner.App.TodoView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <DockPanel>
  <TextBox DockPanel.Dock="Top" Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}" ToolTip="Новая задача — Enter" AutomationProperties.Name="Новая задача">
   <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding AddCommand}"/></TextBox.InputBindings>
  </TextBox>
  <TextBlock DockPanel.Dock="Bottom" Text="Enter — добавить · перетащите для сортировки" FontSize="10" Opacity="0.65" Margin="0,6"/>
  <ListBox ItemsSource="{Binding Todo}" AllowDrop="True" PreviewMouseLeftButtonDown="StartDrag" PreviewMouseRightButtonDown="StopDrag" MouseMove="DragTask" Drop="DropTask">
   <ListBox.ItemTemplate><DataTemplate>
    <Border Background="#12FFFFFF" CornerRadius="9" Padding="6" Margin="0,3">
     <Border.ContextMenu>
      <ContextMenu>
       <MenuItem Header="Редактировать" Click="EditFromMenu"/>
       <Separator/>
       <MenuItem Header="Удалить" Click="DeleteFromMenu"/>
      </ContextMenu>
     </Border.ContextMenu>
     <DockPanel>
      <CheckBox DockPanel.Dock="Left" IsChecked="False" Command="{Binding DataContext.CompleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="Завершить задачу"/>
      <Button DockPanel.Dock="Right" Width="28" Height="28" Padding="5" VerticalAlignment="Center"
              Command="{Binding DataContext.ShowInCalendarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
              AutomationProperties.Name="Показать задачу в календаре" ToolTipService.ShowOnDisabled="True">
       <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="ToolTip" Value="Показать в календаре"/>
        <Style.Triggers><DataTrigger Binding="{Binding CalendarEventId}" Value="{x:Null}"><Setter Property="ToolTip" Value="Сначала перетащите задачу в календарь"/></DataTrigger></Style.Triggers>
       </Style></Button.Style>
       <Path Data="M 3,4 L 15,4 L 15,16 L 3,16 Z M 3,8 L 15,8 M 6,2 L 6,6 M 12,2 L 12,6 M 6,11 L 8,11 M 10,11 L 12,11 M 6,14 L 8,14"
             Stroke="White" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Stretch="Uniform"/>
      </Button>
      <StackPanel Margin="5,5">
       <Grid>
        <TextBlock x:Name="TaskTitle" Text="{Binding Title}" TextWrapping="Wrap" MouseLeftButtonDown="BeginRename" ToolTip="Дважды щёлкните, чтобы переименовать"/>
        <TextBox x:Name="TaskTitleEditor" Text="{Binding Title}" Visibility="Collapsed" KeyDown="RenameKeyDown" LostKeyboardFocus="FinishRename"/>
       </Grid>
       <TextBlock Text="{Binding ScheduledStart, StringFormat={}{0:dd.MM HH:mm}}" FontSize="10" Opacity="0.65"/>
      </StackPanel>
     </DockPanel>
    </Border>
   </DataTemplate></ListBox.ItemTemplate>
  </ListBox>
 </DockPanel>
</UserControl>


