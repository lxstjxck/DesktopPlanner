<UserControl x:Class="DesktopPlanner.App.MonthTrackerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button Content="‹" Command="{Binding PreviousMonthCommand}" Padding="8,2" FontSize="18" ToolTip="Предыдущий месяц"/>
      <TextBlock Grid.Column="1" Text="{Binding MonthLabel}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
      <Button Grid.Column="2" Content="›" Command="{Binding NextMonthCommand}" Padding="8,2" FontSize="18" ToolTip="Следующий месяц"/>
    </Grid>
    <Button Grid.Row="1" Content="Сегодня" Command="{Binding TodayCommand}" HorizontalAlignment="Center" Padding="9,3"/>
    <Grid Grid.Row="2" Margin="0,6,0,3">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <ItemsControl Grid.Row="0" ItemsSource="{Binding WeekdayNames}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" HorizontalAlignment="Center" Opacity="0.65" FontSize="11"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <ItemsControl Grid.Row="1" ItemsSource="{Binding Days}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
        <Button Command="{Binding DataContext.ToggleDayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Date}" IsEnabled="{Binding IsInMonth}" Margin="2" Padding="0" Background="{Binding MarkBrush}" BorderBrush="#40FFFFFF" BorderThickness="1" FontSize="13">
          <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Cell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Cell" Property="Opacity" Value="0.8"/></Trigger><DataTrigger Binding="{Binding IsToday}" Value="True"><Setter TargetName="Cell" Property="BorderBrush" Value="#FFFFFFFF"/><Setter TargetName="Cell" Property="BorderThickness" Value="2"/></DataTrigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Cell" Property="Opacity" Value="0.25"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
          <TextBlock Text="{Binding DayNumber}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </Grid>
    <TextBlock Grid.Row="3" Text="{Binding Status}" FontSize="10" Opacity="0.65" HorizontalAlignment="Center"/>
  </Grid>
</UserControl>
