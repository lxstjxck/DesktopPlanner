<UserControl x:Class="DesktopPlanner.App.InboxView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <DockPanel>
  <StackPanel DockPanel.Dock="Top">
   <DockPanel>
    <Button DockPanel.Dock="Right" Content="＋" Command="{Binding AddInboxCommand}" ToolTip="Добавить событие"/>
    <TextBox Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}" ToolTip="Название события — Enter" AutomationProperties.Name="Название события"><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding AddInboxCommand}"/></TextBox.InputBindings></TextBox>
   </DockPanel>
   <Expander Header="Описание" FontSize="11" Foreground="White" Margin="2,2"><TextBox Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}" ToolTip="Описание (необязательно)"/></Expander>
  </StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Margin="0,6">
   <TextBlock Text="Перетащите событие на нужный день и время в календаре" FontSize="10" TextWrapping="Wrap" Opacity="0.75"/>
   <TextBlock Text="{Binding Status}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" Opacity="0.8"/>
  </StackPanel>
  <ListBox x:Name="InboxItems" ItemsSource="{Binding Inbox}" PreviewMouseLeftButtonDown="StartDrag" PreviewMouseLeftButtonUp="EndDrag">
   <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
   <ListBox.ItemTemplate><DataTemplate>
    <Border Background="#18FFFFFF" CornerRadius="8" Padding="8" Margin="0,4" Cursor="Hand" ToolTip="Перетащите в календарь — событие займёт 1 час. Длительность можно изменить."><DockPanel>
     <Button DockPanel.Dock="Right" Content="×" ToolTip="Удалить из входящих" Command="{Binding DataContext.DeleteInboxCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
     <TextBlock DockPanel.Dock="Left" Text="⠿" FontSize="21" Opacity="0.6" VerticalAlignment="Center" Margin="0,0,9,0"/>
     <StackPanel><TextBlock Text="{Binding Title}" TextWrapping="Wrap"/><TextBlock Text="{Binding Description}" Opacity="0.65" FontSize="11" TextWrapping="Wrap"/></StackPanel>
    </DockPanel></Border>
   </DataTemplate></ListBox.ItemTemplate>
  </ListBox>
 </DockPanel>
</UserControl>



