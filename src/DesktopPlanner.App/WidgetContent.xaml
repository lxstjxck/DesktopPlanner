<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DesktopPlanner.App">
 <DataTemplate x:Key="Todo"><local:TodoView/></DataTemplate>
 <DataTemplate x:Key="Notes">
  <TextBox Background="Transparent" BorderBrush="Transparent" FontSize="15" Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsUndoEnabled="True" UndoLimit="200" VerticalContentAlignment="Top" AutomationProperties.Name="Заметки"/>
 </DataTemplate>
 <DataTemplate x:Key="Completed">
  <ListBox ItemsSource="{Binding Completed}"><ListBox.ItemTemplate><DataTemplate>
   <Border Background="#12FFFFFF" CornerRadius="9" Padding="8" Margin="0,3"><StackPanel>
    <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding CompletedAt, StringFormat={}{0:dd.MM.yyyy HH:mm} UTC}" FontSize="10" Opacity="0.6"/>
    <StackPanel Orientation="Horizontal">
     <Button Content="Вернуть" Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
     <Button Content="Удалить" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
    </StackPanel>
   </StackPanel></Border>
  </DataTemplate></ListBox.ItemTemplate></ListBox>
 </DataTemplate>
 <DataTemplate x:Key="Inbox"><local:InboxView DataContext="{Binding Calendar}"/></DataTemplate>
 <DataTemplate x:Key="Week"><local:WeekView DataContext="{Binding Calendar}"/></DataTemplate>
</ResourceDictionary>



