<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <LinearGradientBrush x:Key="GlassMenuSurface" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F04F647B"/><GradientStop Color="#F027384E" Offset="1"/></LinearGradientBrush>
 <LinearGradientBrush x:Key="GlassEdge" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#A0FFFFFF"/><GradientStop Color="#20FFFFFF" Offset=".5"/><GradientStop Color="#60A4CFF4" Offset="1"/></LinearGradientBrush>
 <SolidColorBrush x:Key="GlassAccent" Color="#8FC3F7"/>
 <Style TargetType="CheckBox">
  <Setter Property="Foreground" Value="#FAFCFF"/><Setter Property="Margin" Value="4,5"/><Setter Property="Padding" Value="3"/>
  <Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
   <Grid Background="Transparent" Margin="{TemplateBinding Padding}"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border x:Name="Box" Width="20" Height="20" CornerRadius="6" Background="#180F1D30" BorderBrush="#70E2EFFF" BorderThickness="1.2" VerticalAlignment="Center">
     <Grid><Path x:Name="Check" Data="M 4,9 L 8,13 L 15,5" Stroke="#14283D" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
      <Border x:Name="Mixed" Width="10" Height="2" Background="#14283D" CornerRadius="1" Visibility="Collapsed"/></Grid>
    </Border>
    <ContentPresenter Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="#35FFFFFF"/><Setter TargetName="Box" Property="BorderBrush" Value="White"/></Trigger>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource GlassAccent}"/><Setter TargetName="Box" Property="BorderBrush" Value="#D0E9FF"/><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger>
    <Trigger Property="IsChecked" Value="{x:Null}"><Setter TargetName="Box" Property="Background" Value="{StaticResource GlassAccent}"/><Setter TargetName="Mixed" Property="Visibility" Value="Visible"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="White"/><Setter TargetName="Box" Property="BorderThickness" Value="2"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Box" Property="Opacity" Value=".7"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ContextMenu">
  <Setter Property="OverridesDefaultStyle" Value="True"/><Setter Property="Foreground" Value="#FAFCFF"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="13"/>
  <Setter Property="MinWidth" Value="230"/><Setter Property="MaxWidth" Value="440"/><Setter Property="HasDropShadow" Value="True"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
   <Border Margin="6" Background="{StaticResource GlassMenuSurface}" BorderBrush="{StaticResource GlassEdge}" BorderThickness="1" CornerRadius="16" Padding="6">
    <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity=".25" Color="#081525"/></Border.Effect>
    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}">
     <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
    </ScrollViewer>
   </Border>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="MenuItem">
  <Setter Property="Foreground" Value="#FAFCFF"/><Setter Property="Padding" Value="9,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
   <Grid>
    <Border x:Name="Row" Background="Transparent" CornerRadius="9" Padding="{TemplateBinding Padding}" Margin="1">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
      <ContentPresenter x:Name="IconSlot" ContentSource="Icon" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Left"/>
      <Path x:Name="Tick" Data="M 2,7 L 6,11 L 13,3" Stroke="{StaticResource GlassAccent}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="15" Height="15" VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="Collapsed"/>
      <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Opacity=".6" Margin="12,0,0,0" VerticalAlignment="Center"/>
      <Path x:Name="Arrow" Grid.Column="3" Data="M 0,0 L 4,4 L 0,8" Stroke="#C0FFFFFF" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
     </Grid>
    </Border>
    <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-3" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
     <Border Margin="5" Padding="6" Background="{StaticResource GlassMenuSurface}" BorderBrush="{StaticResource GlassEdge}" BorderThickness="1" CornerRadius="14">
      <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" MaxHeight="480"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle"/></ScrollViewer>
     </Border>
    </Popup>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="#27D3E8FF"/></Trigger>
    <Trigger Property="IsSubmenuOpen" Value="True"><Setter TargetName="Row" Property="Background" Value="#27D3E8FF"/></Trigger>
    <Trigger Property="HasItems" Value="True"><Setter TargetName="Arrow" Property="Visibility" Value="Visible"/></Trigger>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Tick" Property="Visibility" Value="Visible"/><Setter TargetName="IconSlot" Property="Visibility" Value="Hidden"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Row" Property="Opacity" Value=".55"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="Separator"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Margin="12,5" Background="#24FFFFFF"/></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator" BasedOn="{StaticResource {x:Type Separator}}"/>
 <Style TargetType="PasswordBox">
  <Setter Property="Foreground" Value="#FAFCFF"/><Setter Property="CaretBrush" Value="White"/><Setter Property="Background" Value="#230F1D30"/><Setter Property="BorderBrush" Value="#40E2EFFF"/><Setter Property="Padding" Value="11,9"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox">
   <Border x:Name="Field" CornerRadius="11" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border>
   <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource GlassAccent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ComboBox">
  <Setter Property="Foreground" Value="#FAFCFF"/><Setter Property="Background" Value="#230F1D30"/><Setter Property="BorderBrush" Value="#40E2EFFF"/><Setter Property="Padding" Value="11,9"/><Setter Property="MinHeight" Value="38"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
   <Grid>
    <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
     <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="11"><Path Data="M 0,0 L 4,4 L 8,0" Stroke="#DEEDFF" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#8FC3F7"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#8FC3F7"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
    </ToggleButton>
    <ContentPresenter IsHitTestVisible="False" Margin="11,9,35,9" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
     <Border Margin="0,4,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Padding="5" Background="{StaticResource GlassMenuSurface}" BorderBrush="{StaticResource GlassEdge}" BorderThickness="1" CornerRadius="12"><ScrollViewer MaxHeight="260" CanContentScroll="True" VerticalScrollBarVisibility="Auto"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border>
    </Popup>
   </Grid>
   <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#FAFCFF"/><Setter Property="Padding" Value="10,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="8"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="#30D3E8FF"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#306DAEF5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ToolTip"><Setter Property="Foreground" Value="#FAFCFF"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip"><Border Background="{StaticResource GlassMenuSurface}" BorderBrush="#50FFFFFF" BorderThickness="1" CornerRadius="9" Padding="10,7"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="Hyperlink"><Setter Property="Foreground" Value="#B9DEFF"/><Setter Property="TextDecorations" Value="Underline"/></Style>
</ResourceDictionary>
