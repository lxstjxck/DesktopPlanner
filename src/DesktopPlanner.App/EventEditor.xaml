<UserControl x:Class="DesktopPlanner.App.EventEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
  <TextBlock Text="Редактировать событие" FontSize="20" Margin="0,0,0,14"/>
  <TextBlock Text="Название"/><TextBox x:Name="TitleInput" Margin="0,4,0,10"/>
  <TextBlock Text="Описание"/><TextBox x:Name="DescriptionInput" AcceptsReturn="True" TextWrapping="Wrap" Height="65" Margin="0,4,0,10"/>
  <TextBlock Text="Место"/><TextBox x:Name="LocationInput" Margin="0,4,0,10"/>
  <CheckBox x:Name="AllDay" Content="Весь день" Margin="0,0,0,10" Checked="AllDayChanged" Unchecked="AllDayChanged"/>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="Начало"/><DatePicker x:Name="StartDate" Margin="0,4"/><TextBox x:Name="StartTime" ToolTip="Время в формате ЧЧ:мм"/></StackPanel>
   <StackPanel Grid.Column="2"><TextBlock Text="Окончание"/><DatePicker x:Name="EndDate" Margin="0,4"/><TextBox x:Name="EndTime" ToolTip="Время в формате ЧЧ:мм"/></StackPanel>
  </Grid>
  <TextBlock x:Name="Error" Foreground="#FFFFB5B5" TextWrapping="Wrap" Margin="0,10"/>
  <TextBlock Text="Для «Весь день» дата окончания включается целиком." FontSize="11" Opacity=".7" TextWrapping="Wrap"/>
  <WrapPanel x:Name="Actions" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Удалить" Click="Delete"/><Button Content="Отмена" Click="Cancel"/><Button Content="Сохранить" Click="Save"/></WrapPanel>
 </StackPanel></ScrollViewer>
</UserControl>
